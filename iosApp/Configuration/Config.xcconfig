TEAM_ID=

PRODUCT_NAME=DataDroid
PRODUCT_BUNDLE_IDENTIFIER=org.onedroid.dataset.DataDroid$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// TensorFlow Lite C runtime, downloaded by Gradle (:shared:downloadTfliteC).
TFLITE_XCFRAMEWORK = $(SRCROOT)/../third_party/tflite-c/2.17.0/TensorFlowLiteC-2.17.0/Frameworks/TensorFlowLiteC.xcframework
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(TFLITE_XCFRAMEWORK)/ios-arm64
FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(TFLITE_XCFRAMEWORK)/ios-arm64_x86_64-simulator
OTHER_LDFLAGS = $(inherited) -framework TensorFlowLiteC -lc++
